{
  "name": "AI Session Free Sample",
  "description": "Sample Chrome extension demonstrating headless AI queries via ai-session-free",
  "version": "0.1.0",
  "manifest_version": 3,
  "permissions": [
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "https://*.chatgpt.com/*",
    "https://*.openai.com/*",
    "https://claude.ai/*",
    "https://*.google.com/*",
    "https://gemini.google.com/*",
    "https://*.kimi.com/*",
    "https://*.kimi.moonshot.cn/*",
    "https://*.kimi.ai/*",
    "https://*.bing.com/*",
    "https://copilot.microsoft.com/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "action": {
    "default_title": "AI Session Free Sample"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.kimi.com/*",
        "https://*.kimi.moonshot.cn/*",
        "https://*.kimi.ai/*",
        "https://chat.deepseek.com/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
