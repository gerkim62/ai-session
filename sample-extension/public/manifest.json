{
  "name": "AI Session Free Sample",
  "description": "Sample Chrome extension demonstrating headless AI queries via ai-session-free",
  "version": "0.1.0",
  "manifest_version": 3,
  "permissions": [
    "cookies",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "https://*.chatgpt.com/*",
    "https://*.openai.com/*",
    "https://claude.ai/*",
    "https://*.google.com/*",
    "https://gemini.google.com/*",
    "https://*.kimi.com/*",
    "https://*.kimi.moonshot.cn/*",
    "https://*.kimi.ai/*",
    "https://*.bing.com/*",
    "https://copilot.microsoft.com/*",
    "https://chat.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AI Session Free Sample"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.kimi.com/*",
        "https://*.kimi.moonshot.cn/*",
        "https://*.kimi.ai/*"
      ],
      "js": ["content-scripts/kimi-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": ["content-scripts/deepseek-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
